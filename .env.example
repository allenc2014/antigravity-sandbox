# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Desktop session
TZ=America/New_York       # see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
PASSWORD=antigravity      # web UI login password

# Git identity for the "abc" desktop user
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Git credential storage
# Options:
#   store  — saves credentials in plaintext at /config/.git-credentials (persisted by volume)
#   cache  — keeps credentials in memory only (lost on container stop)
#   <leave blank>  — git will prompt for credentials every time
GIT_CREDENTIAL_HELPER=store

# How long 'cache' mode remembers credentials (seconds). Default: 900 (15 min)
# GIT_CREDENTIAL_CACHE_TIMEOUT=3600
